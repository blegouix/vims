#!/usr/bin/env bash
set -euo pipefail

# vims: vim wrapper that reuses a single Vim clientserver instance.
#
# NOTE ABOUT fg/JOB CONTROL:
# - Real shell job control (fg/bg, job IDs) only works in the current interactive shell.
# - That means the reliable "use fg" behavior is when this logic is used as a shell function
#   (for example from ~/.bashrc), not as a standalone executable process.
#
# This script still works as an executable and forwards all arguments to one Vim server.
# When job control metadata exists in environment variables (typically set by shell function
# usage), it will try to foreground that job with `fg` before exiting.

SERVER_NAME="${VIMS_SERVER:-VIMS}"
VIM_BIN="${VIMS_VIM:-vim}"

has_clientserver() {
  "$VIM_BIN" --version 2>/dev/null | grep -Eq '^\+clientserver\b'
}

server_exists() {
  "$VIM_BIN" --serverlist 2>/dev/null | tr ' ' '\n' | grep -Fxq "$SERVER_NAME"
}

try_fg_job() {
  # Works only in interactive shells where this runs in the current shell context.
  # VIMS_JOB stores values like "%1".
  if [[ ${VIMS_JOB:-} != "" ]] && [[ $- == *i* ]]; then
    fg "$VIMS_JOB" >/dev/null 2>&1 || true
  fi
}

if ! command -v "$VIM_BIN" >/dev/null 2>&1; then
  echo "vims: '$VIM_BIN' was not found in PATH" >&2
  exit 127
fi

if ! has_clientserver; then
  cat >&2 <<MSG
vims: $VIM_BIN does not have +clientserver.
Install a Vim build with +clientserver support (see README.md).
MSG
  exit 2
fi

if server_exists; then
  if (($# > 0)); then
    exec "$VIM_BIN" --servername "$SERVER_NAME" --remote-silent "$@"
  fi

  try_fg_job
  exit 0
else
  exec "$VIM_BIN" --servername "$SERVER_NAME" "$@"
fi
